generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  RECRUITER
  HR
  CANDIDATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum SkillType {
  TECHNICAL
  SOFT
  DOMAIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum InterviewType {
  TECHNICAL
  HR
  BEHAVIORAL
  FINAL
  AI_ASSESSMENT
}

enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchRecommendation {
  STRONG_MATCH
  GOOD_MATCH
  PARTIAL_MATCH
  WEAK_MATCH
  NOT_RECOMMENDED
}

// ============================================================
// USER
// ============================================================

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CANDIDATE)

  phone        String?
  profileImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recruiter Recruiter?
  hr        HR?
  candidate Candidate?

  @@index([email])
  @@index([role])
}

// ============================================================
// COMPANY
// ============================================================

model Company {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  website     String?
  industry    String?
  location    String?
  logoUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recruiters Recruiter[]
  hrUsers    HR[]
  jobs       Job[]

  @@index([name])
  @@index([industry])
}

// ============================================================
// RECRUITER
// ============================================================

model Recruiter {
  id        Int @id @default(autoincrement())
  userId    Int @unique
  companyId Int

  designation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobs Job[]

  @@index([companyId])
}

// ============================================================
// HR
// ============================================================

model HR {
  id        Int @id @default(autoincrement())
  userId    Int @unique
  companyId Int

  designation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ============================================================
// CANDIDATE
// ============================================================

model Candidate {
  id     Int @id @default(autoincrement())
  userId Int @unique

  headline       String?
  summary        String?
  location       String?
  experience     Float?
  education      String?
  currentRole    String?
  currentCompany String?

  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes      Resume[]
  skills       CandidateSkill[]
  applications Application[]
  interviews   Interview[]
  skillGaps    SkillGap[]

  @@index([location])
  @@index([currentRole])
}

// ============================================================
// JOB
// ============================================================

model Job {
  id          Int @id @default(autoincrement())
  recruiterId Int
  companyId   Int

  title       String
  description String
  location    String?

  jobType         JobType
  workMode        WorkMode
  experienceLevel ExperienceLevel

  minExperience Float?
  maxExperience Float?

  salaryMin Float?
  salaryMax Float?
  currency  String? @default("INR")

  status JobStatus @default(DRAFT)

  openings Int @default(1)

  applicationDeadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recruiter Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  skills       JobSkill[]
  applications Application[]

  @@index([recruiterId])
  @@index([companyId])
  @@index([status])
  @@index([title])
}

// ============================================================
// SKILL
// ============================================================

model Skill {
  id Int @id @default(autoincrement())

  name        String    @unique
  description String?
  type        SkillType @default(TECHNICAL)

  createdAt DateTime @default(now())

  candidates   CandidateSkill[]
  jobs         JobSkill[]
  skillGaps    SkillGap[]
  resumeSkills ResumeSkill[]

  @@index([name])
  @@index([type])
}

// ============================================================
// CANDIDATE SKILL
// ============================================================

model CandidateSkill {
  id Int @id @default(autoincrement())

  candidateId Int
  skillId     Int

  level             SkillLevel @default(BEGINNER)
  yearsOfExperience Float?

  createdAt DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@index([candidateId])
  @@index([skillId])
}

// ============================================================
// JOB SKILL
// ============================================================

model JobSkill {
  id Int @id @default(autoincrement())

  jobId   Int
  skillId Int

  required   Boolean @default(true)
  importance Int     @default(1)

  createdAt DateTime @default(now())

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
}

// ============================================================
// RESUME
// ============================================================

model Resume {
  id Int @id @default(autoincrement())

  candidateId Int

  fileName String
  fileUrl  String?
  fileType String?
  fileSize Int?

  extractedText String?

  status ResumeStatus @default(UPLOADED)

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  applications Application[]
  parsedSkills ResumeSkill[]

  @@index([candidateId])
  @@index([status])
}

// ============================================================
// RESUME SKILL
// ============================================================

model ResumeSkill {
  id Int @id @default(autoincrement())

  resumeId Int
  skillId  Int

  level      SkillLevel?
  confidence Float?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([resumeId, skillId])
  @@index([resumeId])
  @@index([skillId])
}

// ============================================================
// APPLICATION
// ============================================================

model Application {
  id Int @id @default(autoincrement())

  candidateId Int
  jobId       Int
  resumeId    Int?

  status ApplicationStatus @default(APPLIED)

  coverLetter String?

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume    Resume?   @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  aiMatchResult AIMatchResult?
  skillGaps     SkillGap[]
  interviews    Interview[]

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
}

// ============================================================
// AI MATCH RESULT
// ============================================================

model AIMatchResult {
  id Int @id @default(autoincrement())

  applicationId Int @unique

  overallScore Float

  skillsScore     Float?
  experienceScore Float?
  educationScore  Float?
  semanticScore   Float?

  recommendation MatchRecommendation

  matchedSkills Json?
  missingSkills Json?
  strengths     Json?
  concerns      Json?

  explanation String?

  modelName    String?
  modelVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([overallScore])
  @@index([recommendation])
}

// ============================================================
// SKILL GAP
// ============================================================

model SkillGap {
  id Int @id @default(autoincrement())

  candidateId   Int
  applicationId Int?
  skillId       Int

  currentLevel  SkillLevel?
  requiredLevel SkillLevel?

  importance Int @default(1)

  recommendation String?

  createdAt DateTime @default(now())

  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  skill       Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([applicationId])
  @@index([skillId])
}

// ============================================================
// INTERVIEW
// ============================================================

model Interview {
  id Int @id @default(autoincrement())

  applicationId Int
  candidateId   Int

  type   InterviewType
  status InterviewStatus @default(SCHEDULED)

  scheduledAt DateTime
  duration    Int?

  meetingLink String?

  interviewerName  String?
  interviewerEmail String?

  notes String?

  score    Float?
  feedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([candidateId])
  @@index([scheduledAt])
  @@index([status])
}